# Placeholder template only: the application scaffold must implement and validate
# the variables it consumes. This file is not a working production configuration.
# Copy to an ignored .env file and fill secrets locally; never commit real values.
NODE_ENV=development
APP_ENV=local
WEB_ORIGIN=http://localhost:3000
API_PORT=3001

# Defaults are not authorization boundaries. Enforce country/currency server-side.
DEFAULT_COUNTRY=TZ
DEFAULT_CURRENCY=TZS

# Server-side only. Keep blank here; obtain sandbox credentials for development.
DATABASE_URL=
AUTH_SESSION_SECRET=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
METER_PROVIDER_API_KEY=
