# Placeholder template only: the application scaffold must implement and validate
# the variables it consumes. This file is not a working production configuration.
# Copy to an ignored .env file and fill secrets locally; never commit real values.
NODE_ENV=development
APP_ENV=local
WEB_ORIGIN=http://localhost:3000
API_PORT=3001

# Defaults are not authorization boundaries. Enforce country/currency server-side.
DEFAULT_COUNTRY=TZ
DEFAULT_CURRENCY=TZS

# Storefront data source: "mock" (sample catalogue, no orders) or "database"
# (catalogue and Cash on Delivery orders in Supabase Postgres via DATABASE_URL).
DATA_SOURCE=mock
DATABASE_POOL_MAX=5
# Seconds catalogue pages may reuse one read of the catalogue (database mode).
# 0 reads the database on every request. Checkout always reads fresh.
CATALOG_CACHE_SECONDS=60

# Supabase Auth, used on the server only (never NEXT_PUBLIC_*). Leave blank to
# keep sign-in, registration and password recovery switched off.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side only. Keep blank here; obtain sandbox credentials for development.
# Use the pooled connection string (port 6543) of a non-production project.
DATABASE_URL=
AUTH_SESSION_SECRET=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
METER_PROVIDER_API_KEY=
