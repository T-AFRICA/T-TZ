{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATA_SOURCE",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "CATALOG_CACHE_SECONDS",
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "WEB_ORIGIN",
        "NEXT_PUBLIC_*",
        "NEXT_DIST_DIR"
      ]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
